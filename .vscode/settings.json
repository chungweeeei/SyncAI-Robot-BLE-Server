{
  // formatOnSave does not fire in "afterDelay" mode, so use onFocusChange
  "files.autoSave": "onFocusChange",
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },

  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.allTargets": true,

  // VS Code Server starts from a non-login shell and can't find the rustup toolchain in
  // ~/.cargo/bin, which causes "Failed to find sysroot". Add it to PATH explicitly.
  "rust-analyzer.server.extraEnv": {
    "PATH": "${userHome}/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
  },

  // rust-analyzer's background clippy competes with manual `cargo build` for the target/ lock,
  // blocking one of them. A separate target directory avoids the contention.
  "rust-analyzer.cargo.targetDir": true
}
